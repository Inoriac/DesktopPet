{
  "formatVersion": "1",
  "id": "desktop-pet.bilibili.tools",
  "name": "B站内容阅读工具",
  "version": "1.0.0",
  "summary": "搜索视频、查询分P、分段阅读字幕与评论；可选本地语音转写，不控制桌面",
  "definition": {
    "instructions": "USAGE.md",
    "requirements": [
      {
        "id": "python",
        "description": "真实接口使用 Python 3.10+ 与 requirements.txt 中的依赖",
        "setup": "在包外虚拟环境安装依赖并配置固定解释器，普通调用不会安装或下载模型"
      },
      {
        "id": "bilibili-login",
        "description": "字幕接口通常需要B站登录；公开信息可能无需登录",
        "setup": "由使用者登录并保管包外 credential.json；主体不处理扫码或Cookie"
      },
      {
        "id": "local-asr",
        "description": "可选转写依赖 requirements-asr.txt、本地 faster-whisper 模型及显式 ASR 配置",
        "setup": "使用者显式准备模型和依赖；普通调用不会下载模型或安装软件"
      }
    ],
    "configuration": [
      {
        "key": "program",
        "description": "可信 Python 3.10+ 解释器绝对路径",
        "kind": "executable",
        "required": true
      },
      {
        "key": "script",
        "description": "本包 adapter.py 的绝对路径",
        "kind": "path",
        "required": true
      },
      {
        "key": "settings",
        "description": "宿主管理的插件配置 JSON 绝对路径",
        "kind": "path",
        "required": true
      }
    ],
    "operations": [
      {
        "id": "status",
        "description": "检查本地依赖与登录文件是否存在；不验证在线登录",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "status"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "读取平台内容或本地状态；字幕可写入包外内容缓存，不在平台发评论、点赞或私信"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "检查完成，不表示网络或登录已可用",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed 或 failed；宿主配置 /state 和 /data 映射"
        }
      },
      {
        "id": "search",
        "description": "按关键词搜索视频摘要",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "order": {
                "type": "string",
                "enum": [
                  "totalrank",
                  "click",
                  "pubdate",
                  "dm"
                ]
              }
            },
            "required": [
              "keyword"
            ],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "search"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "读取平台内容或本地状态；字幕可写入包外内容缓存，不在平台发评论、点赞或私信"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "取得指定结果页，返回真实BV号与来源链接",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed 或 failed；宿主配置 /state 和 /data 映射"
        }
      },
      {
        "id": "video_info",
        "description": "读取指定分P的视频信息和时长",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {
              "bvid": {
                "type": "string",
                "pattern": "^BV[1-9A-HJ-NP-Za-km-z]{10}(?![\\s\\S])"
              },
              "part": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "required": [
              "bvid"
            ],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "video_info"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "读取平台内容或本地状态；字幕可写入包外内容缓存，不在平台发评论、点赞或私信"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "核实指定分P并取得CID和简介，truncated标明摘要裁剪",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed 或 failed；宿主配置 /state 和 /data 映射"
        }
      },
      {
        "id": "comments",
        "description": "读取指定视频的一页评论样本",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {
              "bvid": {
                "type": "string",
                "pattern": "^BV[1-9A-HJ-NP-Za-km-z]{10}(?![\\s\\S])"
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "bvid"
            ],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "comments"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "读取平台内容或本地状态；字幕可写入包外内容缓存，不在平台发评论、点赞或私信"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "取得评论样本，空评论与请求失败分开表示",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed 或 failed；宿主配置 /state 和 /data 映射"
        }
      },
      {
        "id": "read_transcript",
        "description": "按页读取带时间戳的字幕或已完成的本地转写",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {
              "bvid": {
                "type": "string",
                "pattern": "^BV[1-9A-HJ-NP-Za-km-z]{10}(?![\\s\\S])"
              },
              "part": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "source": {
                "type": "string",
                "enum": [
                  "platform_subtitle",
                  "local_asr"
                ]
              },
              "cursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
              }
            },
            "required": [
              "bvid"
            ],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "read_transcript"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "读取平台内容或本地状态；字幕可写入包外内容缓存，不在平台发评论、点赞或私信"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "取得当前文本页或明确内容不可用；不代表已经理解整段视频",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed 或 failed；宿主配置 /state 和 /data 映射"
        }
      },
      {
        "id": "start_transcription",
        "description": "可选：受理指定分P的后台语音转写，只使用已准备的本地模型",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {
              "bvid": {
                "type": "string",
                "pattern": "^BV[1-9A-HJ-NP-Za-km-z]{10}(?![\\s\\S])"
              },
              "part": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "required": [
              "bvid"
            ],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "start_transcription"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "write",
          "description": "仅创建包外转写任务、下载目标音频并运行本地计算；不会执行平台写操作"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "accepted 仅表示后台任务已受理；通过真实回执查询完成后再读 local_asr",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed/failed/accepted；accepted 必须映射 /receipt 与 /tracking"
        }
      },
      {
        "id": "transcription_status",
        "description": "查询真实转写回执的状态，不启动或重试任务",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
              }
            },
            "required": [
              "job_id"
            ],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            "-B",
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "transcription_status"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "只读取本地转写状态，不触发下载或计算"
        },
        "result": {
          "format": "json",
          "description": "envelope.data 中的有界材料、来源与可选错误",
          "successMeaning": "完成本次状态查询，data.status 区分 queued/running/completed/failed/unknown",
          "failureMeaning": "未取得请求材料；错误码区分登录、限流、网络与输入问题",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed 或 failed；任务执行状态在 data.status"
        }
      }
    ]
  }
}
