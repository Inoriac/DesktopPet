        "id": "status",
        "description": "获取真实播放状态",
        "parameters": {
          "source": "inline",
          "schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "invocation": {
          "kind": "command",
          "program": {
            "setting": "program"
          },
          "arguments": [
            {
              "setting": "script"
            },
            "--settings",
            {
              "setting": "settings"
            },
            "--operation",
            "status"
          ],
          "stdin": "json"
        },
        "effects": {
          "kind": "read",
          "description": "只读本地 API 或数据库，不启动播放器"
        },
        "result": {
          "format": "json",
          "description": "适配器 envelope.data 中的真实结果与可选错误",
          "successMeaning": "取得真实播放状态",
          "failureMeaning": "未取得已声明的成功结果；unknown 时可能已经发生写入，禁止自动重发",
          "completion": "reported",
          "stateDescription": "envelope.state 为 completed、failed 或 unknown；宿主必须配置 /state 与 /data 映射"
        }
      },
      {
