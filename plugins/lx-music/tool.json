{
  "formatVersion": "1",
  "id": "desktop-pet.lx-music.tools",
  "name": "LX Music 音乐工具",
  "version": "1.0.0",
  "summary": "查询状态、歌词、歌单，以及显式播放控制；写入不确定时不自动重发",
  "definition": {
    "instructions": "USAGE.md",
    "requirements": [
      {
        "id": "python",
        "description": "Python 3.9+，只使用标准库",
        "setup": "在宿主配置绝对 Python 解释器与随包 adapter.py 路径"
      },
      {
        "id": "lx-music",
        "description": "使用 API 控制需要已启用的 LX Music 本地开放 API；歌单查询需要可读 SQLite 文件",
        "setup": "配置连接 JSON 中的 apiUrl、database 和可选 executable；先运行只读 --diagnose"
      }
    ],
    "configuration": [
      {
        "key": "program",
        "description": "可信 Python 3.9+ 解释器绝对路径",
        "kind": "executable",
        "required": true
      },
      {
        "key": "script",
        "description": "本能力包 adapter.py 的绝对路径",
        "kind": "path",
        "required": true
      },
      {
        "key": "settings",
        "description": "宿主管理的连接 JSON 绝对路径",
        "kind": "path",
        "required": true
      }
    ],
    "operations": [
