{
  "formatVersion": "1",
  "id": "example.controlled-events",
  "protocol": "unknown",
  "requirements": [],
  "configuration": [
    {
      "key": "program",
      "kind": "executable",
      "required": true,
      "description": "Trusted Python interpreter"
    },
    {
      "key": "script",
      "kind": "path",
      "required": true,
      "description": "Absolute immutable adapter script"
    },
    {
      "key": "database",
      "kind": "path",
      "required": true,
      "description": "Adapter journal outside the package"
    }
  ],
  "invocation": {
    "kind": "command",
    "program": {
      "setting": "program"
    },
    "arguments": [
      {
        "setting": "script"
      },
      "--database",
      {
        "setting": "database"
      },
      "--operation",
      "source"
    ]
  }
}
